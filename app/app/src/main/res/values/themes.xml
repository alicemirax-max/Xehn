<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The activity is edge-to-edge Compose, so this theme exists only to set the
      launch background and avoid a white flash before the first frame.
    -->
    <style name="Theme.TunTrail" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
